---

<Layout
  title="Prakash Hyundai Nizamabad | Best Price & EMI ☎ 9052110303"
  description="4.7★ (2,915+ reviews). Authorized Hyundai dealer in Nizamabad — Creta, Venue, Exter, i20 at today's best price. Free home test drive. Call 9052110303."
  canonical="https://www.prakashhyundai.com/"
  noOrgSchema={true}
>

  <script type="application/ld+json" set:html={JSON.stringify(hyRatingSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ============================================================
       HERO — Catalogue opening: quiet type, one photograph, no chrome.
       ============================================================ -->
  <section class="bg-paper">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 py-12 lg:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16">
        <div>
          <p class="hy-eyebrow">Authorised dealer · 9 showrooms · Nizamabad</p>

          <h1 class="mt-5 text-[clamp(2rem,4.6vw,3.5rem)] font-light leading-[1.1] tracking-display text-ink">
            The full Hyundai range,<br class="hidden sm:block" />
            <span class="font-medium text-hyundai-blue">on the road from Nizamabad.</span>
          </h1>

          <p class="mt-6 max-w-xl text-base leading-relaxed text-body">
            Today's best ex-showroom price on Creta, Venue, Exter, i20 and every other model.
            Free home test drive. Easy EMI. Trusted by 2,915+ Nizamabad families.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={`${WA}?text=${encodeURIComponent("Hi Prakash Hyundai, I want today's best price on a Hyundai car in Nizamabad. [W-HP]")}`}
              target="_blank" rel="noopener noreferrer" class="hy-btn hy-btn--wa">
              Best price on WhatsApp
            </a>
            <a href={PHONE} class="hy-btn">Call 90521 10303</a>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-rule pt-6">
            <div>
              <p class="text-2xl font-medium text-ink">₹8,500</p>
              <p class="mt-0.5 text-xs text-body">Exter EMI, per month</p>
            </div>
            <div class="hidden sm:block h-10 w-px bg-rule" aria-hidden="true"></div>
            <div>
              <p class="text-2xl font-medium text-ink">4.7 / 5</p>
              <p class="mt-0.5 text-xs text-body">2,915+ Google reviews</p>
            </div>
            <div class="hidden sm:block h-10 w-px bg-rule" aria-hidden="true"></div>
            <a
              href={`${WA}?text=${encodeURIComponent("Hi, I want to check EMI eligibility for a Hyundai car in Nizamabad. [W-EMI]")}`}
              target="_blank" rel="noopener noreferrer"
              class="text-sm text-hyundai-blue underline underline-offset-4 decoration-rule hover:decoration-hyundai-blue transition-colors duration-150">
              Check EMI eligibility
            </a>
          </div>
        </div>

        <figure class="relative">
          <img
            src="/images/hero-venue.jpg"
            alt="Hyundai on the forecourt at Prakash Hyundai, the authorised Hyundai showroom in Nizamabad"
            class="w-full rounded-sm object-cover"
            width="1200" height="800"
            fetchpriority="high" loading="eager" decoding="async" />
          <figcaption class="mt-3 text-xs text-muted">
            Hyderabad Road, Dichpally · Mon–Sat, 9 AM – 7 PM
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============================================================
       ASSURANCES — sand band, plain language
       ============================================================ -->
  <section class="bg-hyundai-sand">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 py-5">
      <ul class="flex flex-wrap items-center gap-x-8 gap-y-2.5 text-sm text-ink2">
        {assurances.map(a => (
          <li>
            <a
              href={a.href}
              target={a.external ? "_blank" : undefined}
              rel={a.external ? "noopener noreferrer" : undefined}
              class="hover:text-hyundai-blue transition-colors duration-150">
              {a.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================================================
       THE CATALOGUE
       ============================================================ -->
  <section id="cars" class="bg-paper">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 py-14 lg:py-20">
      <div class="flex flex-col gap-4 border-b border-rule pb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="hy-eyebrow">The range</p>
          <h2 class="mt-3 text-[clamp(1.5rem,3vw,2.5rem)] font-light leading-tight tracking-display text-ink">
            Hyundai cars in Nizamabad
          </h2>
          <p class="mt-2 text-sm text-body">All models · ex-showroom price · free test drive at your door</p>
        </div>
        <a
          href={`${WA}?text=${encodeURIComponent("Hi Prakash Hyundai, please share price list for all Hyundai cars in Nizamabad. [W-HP-PL]")}`}
          target="_blank" rel="noopener noreferrer" class="hy-btn hy-btn--outline self-start sm:self-auto">
          Full price list
        </a>
      </div>

      <ul class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {sortedCars.map(car => (
          <li class="group flex flex-col">
            <a href={`/cars/${car.slug}`} class="block">
              <div class="relative overflow-hidden rounded-sm bg-paper2">
                <img
                  src={car.data.image}
                  alt={`Hyundai ${car.data.name} price in Nizamabad`}
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  loading="lazy" decoding="async" />
                <span class="absolute left-3 top-3 rounded-sm bg-paper/90 px-2 py-1 text-[10px] font-medium uppercase tracking-eyebrow text-hyundai-blue backdrop-blur">
                  {car.data.category}
                </span>
              </div>

              <h3 class="mt-4 text-lg font-medium leading-snug text-ink transition-colors duration-150 group-hover:text-hyundai-blue">
                Hyundai {car.data.name}
              </h3>
              <p class="mt-2 border-t border-rule pt-2 text-xs uppercase tracking-eyebrow text-muted">Ex-showroom Nizamabad</p>
              <p class="mt-0.5 text-base font-medium text-hyundai-blue">{car.data.price}</p>
            </a>

            <div class="mt-4 flex flex-col gap-2">
              <a
                href={`${WA}?text=${encodeURIComponent(`Hi Prakash Hyundai, I am interested in the Hyundai ${car.data.name}. Please share today's best price and EMI options in Nizamabad. [W-HP-CAR]`)}`}
                target="_blank" rel="noopener noreferrer" class="hy-btn hy-btn--wa w-full !min-h-[2.75rem]">
                Get best price
              </a>
              <a
                href={`${WA}?text=${encodeURIComponent(`Hi Prakash Hyundai, I want a free test drive for the Hyundai ${car.data.name} in Nizamabad. [W-HP-TD]`)}`}
                target="_blank" rel="noopener noreferrer" class="hy-btn hy-btn--outline w-full !min-h-[2.75rem]">
                Book test drive
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================================================
       WHAT YOU GET
       ============================================================ -->
  <section class="border-y border-rule bg-paper2">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 py-14 lg:py-20">
      <div class="grid gap-10 md:grid-cols-3">
        <a href={PHONE} class="group border-t-2 border-hyundai-blue pt-6 transition-colors duration-150">
          <ShieldCheck size={26} strokeWidth={1.4} className="text-hyundai-blue" />
          <h2 class="mt-4 text-xl font-medium text-ink group-hover:text-hyundai-blue transition-colors duration-150">Authorised service</h2>
          <p class="mt-2 text-sm leading-relaxed text-body">Hyundai-certified technicians, genuine parts and full warranty support at every location.</p>
        </a>
        <a
          href={`${WA}?text=${encodeURIComponent("Hi Prakash Hyundai, I want to know about finance options and delivery timeline. [W-FIN]")}`}
          target="_blank" rel="noopener noreferrer" class="group border-t-2 border-hyundai-blue pt-6">
          <Clock size={26} strokeWidth={1.4} className="text-hyundai-blue" />
          <h2 class="mt-4 text-xl font-medium text-ink group-hover:text-hyundai-blue transition-colors duration-150">Fast delivery, easy finance</h2>
          <p class="mt-2 text-sm leading-relaxed text-body">Loan approval in minutes through SBI, HDFC, Axis and others. Zero down payment on select models.</p>
        </a>
        <a
          href={`${WA}?text=${encodeURIComponent("Hi Prakash Hyundai, I want to book a free home test drive. [W-HP-TD]")}`}
          target="_blank" rel="noopener noreferrer" class="group border-t-2 border-hyundai-blue pt-6">
          <Car size={26} strokeWidth={1.4} className="text-hyundai-blue" />
          <h2 class="mt-4 text-xl font-medium text-ink group-hover:text-hyundai-blue transition-colors duration-150">Test drive at your door</h2>
          <p class="mt-2 text-sm leading-relaxed text-body">Any Hyundai, brought to you — Nizamabad, Armoor, Bodhan, Banswada and beyond.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SHOWROOM DIRECTORY
       ============================================================ -->
  <section class="bg-paper">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 py-14 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-16">
        <div>
          <p class="hy-eyebrow">Where to find us</p>
          <h2 class="mt-3 text-[clamp(1.5rem,3vw,2.5rem)] font-light leading-tight tracking-display text-ink">
            Nine showrooms across the district
          </h2>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-body">
            Sales, service and genuine parts from Nizamabad out to Adilabad, Mancheriyal,
            Nirmal and Bhainsa.
          </p>
          <a href="/locations" class="hy-btn hy-btn--outline mt-7">All locations</a>
        </div>

        <ul class="border-t border-rule">
          {showroomDirectory.map(s => (
            <li>
              <a href={s.href} class="hy-row-link">
                <span class="min-w-0">
                  <span class="block text-base text-ink">{s.label}</span>
                  <span class="block text-xs text-muted">{s.note}</span>
                </span>
                <span class="shrink-0 text-sm text-body">{s.phone}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================================================
       GUIDES
       ============================================================ -->
  <section class="border-t border-rule bg-paper">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 py-14 lg:py-20">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="hy-eyebrow">Reading</p>
          <h2 class="mt-3 text-[clamp(1.5rem,3vw,2.25rem)] font-light leading-tight tracking-display text-ink">Car guides &amp; tips</h2>
        </div>
        <a href="/blog/" class="hy-btn hy-btn--outline self-start sm:self-auto">All guides</a>
      </div>

      <ul class="mt-10 border-t border-rule">
        {recentBlogs.map(post => (
          <li class="border-b border-rule">
            <a href={`/blog/${post.slug}/`} class="group grid gap-2 py-6 sm:grid-cols-[minmax(0,180px)_minmax(0,1fr)_auto] sm:items-baseline sm:gap-8">
              <span class="text-xs font-medium uppercase tracking-eyebrow text-hyundai-active">{post.data.category}</span>
              <span class="min-w-0">
                <span class="block text-lg font-medium leading-snug text-ink transition-colors duration-150 group-hover:text-hyundai-blue">{post.data.title}</span>
                <span class="mt-1 block text-sm text-body line-clamp-2">{post.data.excerpt}</span>
              </span>
              <span class="text-xs text-muted whitespace-nowrap">{new Date(post.data.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })} · {post.data.readTime}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================================================
       FAQ
       ============================================================ -->
  <section class="bg-hyundai-sand">
    <div class="mx-auto max-w-4xl px-5 sm:px-8 py-14 lg:py-20">
      <h2 class="text-[clamp(1.5rem,3vw,2.25rem)] font-light leading-tight tracking-display text-ink">Frequently asked questions</h2>
      <div class="mt-8 border-t border-hyundai-sand2">
        {faqs.map(item => (
          <details class="group border-b border-hyundai-sand2">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-base font-medium text-ink [&::-webkit-details-marker]:hidden">
              <span class="min-w-0">{item.q}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" class="shrink-0 text-hyundai-blue transition-transform duration-200 ease-out group-open:rotate-45"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="pb-5 text-sm leading-relaxed text-ink2">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       REVIEWS
       ============================================================ -->
  <section class="bg-paper">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 py-14 lg:py-20">
      <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
        <h2 class="text-[clamp(1.5rem,3vw,2.25rem)] font-light leading-tight tracking-display text-ink">What our customers say</h2>
        <p class="text-sm text-body">4.7 / 5 · 2,915+ reviews</p>
      </div>

      <ul class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {reviews.map(r => (
          <li class="border-t border-rule pt-5">
            <p class="flex items-center gap-1" aria-label="5 out of 5">
              {Array.from({ length: 5 }).map(() => (
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="text-hyundai-active"><path d="m12 2 3 6.5 7 .9-5 4.9 1.2 7L12 18l-6.2 3.3L7 14.3 2 9.4l7-.9L12 2Z"/></svg>
              ))}
            </p>
            <blockquote class="mt-3 text-sm leading-relaxed text-body">{r.text}</blockquote>
            <p class="mt-4 text-sm font-medium text-ink">{r.name}</p>
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="https://www.google.com/maps/search/Prakash+Hyundai+Nizamabad" target="_blank" rel="noopener noreferrer" class="hy-btn hy-btn--outline">
          Read all Google reviews
        </a>
        <a
          href={`${WA}?text=${encodeURIComponent("Hi Prakash Hyundai, I want to book a test drive and get today's best price. [W-HP-REV]")}`}
          target="_blank" rel="noopener noreferrer" class="hy-btn">
          Book a test drive
        </a>
      </div>
    </div>
  </section>

  <!-- Sticky mobile action bar -->
  <div class="fixed bottom-0 left-0 right-0 z-40 grid grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] gap-2 border-t border-rule bg-paper p-2.5 sm:hidden">
    <a href={PHONE} class="hy-btn">Call</a>
    <a
      href={`${WA}?text=${encodeURIComponent("Hi Prakash Hyundai, I want today's best price on a Hyundai car in Nizamabad. [W-HP-BAR]")}`}
      target="_blank" rel="noopener noreferrer" class="hy-btn hy-btn--wa">
      Get best price
    </a>
  </div>
  <div class="h-20 sm:hidden" aria-hidden="true"></div>

</Layout>
