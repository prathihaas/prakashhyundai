---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

function parseFAQ(body: string): { question: string; answer: string }[] {
  const pairs: { question: string; answer: string }[] = [];
  const lines = body.split('\n');
  let i = 0;
  while (i < lines.length) {
    const qMatch = lines[i].match(/^\*\*Q:\s*(.+?)\*\*$/);
    if (qMatch) {
      const question = qMatch[1].trim();
      let answer = '';
      i++;
      while (i < lines.length && !lines[i].match(/^\*\*Q:/)) {
        const line = lines[i].trim();
        if (line && line !== '---') { answer = line; break; }
        i++;
      }
      if (question && answer) pairs.push({ question, answer });
    } else {
      i++;
    }
  }
  return pairs;
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, title_te, seo_title, seo_description, featured_image, excerpt, category, readTime, author, tags, date, faq } = post.data;

const displayDate = date.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
const postUrl = `https://www.prakashhyundai.com/blog/${post.slug}/`;

const isBrandAuthor = !author || author.toLowerCase().includes('team') || author.toLowerCase().includes('prakash hyundai');
const authorSchema = isBrandAuthor
  ? { "@type": "Organization", "name": "Prakash Hyundai", "url": "https://www.prakashhyundai.com" }
  : { "@type": "Person", "name": author };

const faqPairs = faq && faq.length > 0
  ? faq.map((item: { q: string; a: string }) => ({ question: item.q, answer: item.a }))
  : parseFAQ(post.body);

const faqSchema = faqPairs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqPairs.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": { "@type": "Answer", "text": answer }
  }))
} : null;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${postUrl}#article`,
  "headline": seo_title || title,
  "description": seo_description || excerpt,
  "image": featured_image || "https://www.prakashhyundai.com/og-image.jpg",
  "author": authorSchema,
  "publisher": {
    "@type": "Organization",
    "name": "Prakash Hyundai",
    "logo": { "@type": "ImageObject", "url": "https://www.prakashhyundai.com/logo.png" }
  },
  "datePublished": date.toISOString(),
  "dateModified": date.toISOString(),
  "url": postUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": postUrl }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.prakashhyundai.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.prakashhyundai.com/blog" },
    { "@type": "ListItem", "position": 3, "name": seo_title || title, "item": postUrl }
  ]
};
---

<Layout
  title={seo_title || `${title} | Prakash Hyundai`}
  description={seo_description || excerpt}
  canonical={postUrl}
  ogType="article"
  noOrgSchema={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <nav class="pt-8 pb-2 max-w-3xl mx-auto px-6">
    <div class="flex items-center gap-2 text-xs text-gray-400 font-semibold uppercase tracking-wider">
      <a href="/" class="hover:text-[#00A1C7] transition">Home</a>
      <span>/</span>
      <a href="/blog/" class="hover:text-[#00A1C7] transition">Blog</a>
      <span>/</span>
      <span class="text-gray-600">{category}</span>
    </div>
  </nav>

  <article class="pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <header class="py-10 text-center">
        <div class="flex items-center justify-center gap-3 mb-5">
          <span class="text-xs font-bold text-[#00A1C7] uppercase tracking-widest bg-[#00A1C7]/10 px-3 py-1 rounded-full">{category}</span>
          {readTime && <span class="text-xs text-gray-400 font-semibold">{readTime}</span>}
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-[#000000] mb-5 leading-tight">{title}</h1>
        <p class="text-lg text-gray-500 leading-relaxed max-w-2xl mx-auto">{excerpt}</p>
        <div class="flex justify-center gap-6 mt-6 text-sm text-gray-400 font-medium">
          <span>{displayDate}</span>
          {author && <span>By {author}</span>}
        </div>
      </header>

      {featured_image && (
        <img src={featured_image} alt={title} class="w-full aspect-video object-cover rounded-2xl shadow-xl mb-10" loading="eager" fetchpriority="high" />
      )}

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {tags.map(tag => (
            <span class="text-xs bg-[#00A1C7]/10 text-[#00A1C7] px-3 py-1 rounded-full font-semibold">{tag}</span>
          ))}
        </div>
      )}

      <div class="prose prose-lg prose-blue mx-auto
        prose-headings:font-bold prose-headings:text-[#002C5F]
        prose-a:text-[#00A1C7] prose-a:font-semibold
        prose-strong:text-[#002C5F]
        prose-img:rounded-xl prose-img:shadow-md
        prose-table:w-full prose-th:bg-[#002C5F] prose-th:text-white prose-th:p-3 prose-td:p-3 prose-td:border">
        <Content />
      </div>

      <div class="mt-16 bg-[#002C5F] text-white rounded-2xl p-10 text-center">
        <h3 class="text-2xl font-bold mb-3">Book a Test Drive at Prakash Hyundai</h3>
        <p class="text-blue-200 mb-8">Visit us in Nizamabad — experience any Hyundai model before you buy.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://wa.me/919052110303?text=Hi%2C%20I%20read%20your%20blog%20and%20want%20to%20know%20more%20about%20Hyundai%20cars.%20%5BW-BLOG%5D"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25D366] text-white px-6 py-3 rounded-full font-bold hover:bg-green-500 transition">
            WhatsApp Us
          </a>
          <a href="tel:+919052110303"
            class="inline-flex items-center gap-2 bg-[#00A1C7] text-white px-6 py-3 rounded-full font-bold hover:bg-sky-400 transition">
            Call Now
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>
