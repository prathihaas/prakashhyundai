---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Certified Used Cars in Nizamabad | Prakash Hyundai"
  description="Certified second-hand cars at Prakash Hyundai, Nizamabad. Live stock with prices, photos, finance and easy EMI. WhatsApp 90521 10303 for details."
  canonical="https://www.prakashhyundai.com/used-cars/"
>
  <section class="bg-[#002C5F] text-white py-10 px-4">
    <div class="max-w-5xl mx-auto">
      <h1 class="text-3xl font-bold">Used cars for sale 🚗</h1>
      <p class="mt-2 opacity-90">Certified pre-owned stock · Finance &amp; easy EMI · Updated live</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-8">
    <div id="stock" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <p id="loading" class="text-gray-500">Loading current stock…</p>
    </div>
    <p class="text-sm text-gray-500 mt-8 text-center">
      Every car is inspected at our workshop. Call / WhatsApp
      <a href="https://wa.me/919052110303" class="text-[#002C5F] font-semibold">90521 10303</a>
      · Prakash Hyundai, Nizamabad
    </p>
  </section>

  <script>
    fetch('https://used.prk.sh/api/stock?dealer=hyundai')
      .then(function (r) { return r.json(); })
      .then(function (items) {
        var grid = document.getElementById('stock');
        if (!grid) return;
        if (!items.length) {
          grid.innerHTML = '<p class="text-gray-500">New stock arriving soon — <a class="text-[#002C5F] font-semibold" href="https://wa.me/919052110303">WhatsApp us</a> for upcoming cars.</p>';
          return;
        }
        grid.innerHTML = items.map(function (t) {
          return '<div class="bg-white rounded-2xl shadow overflow-hidden">' +
            '<img src="' + t.photo + '" alt="' + t.brand + ' ' + t.model + '" loading="lazy" class="w-full h-48 object-cover bg-gray-100">' +
            '<div class="p-4">' +
            '<div class="font-bold text-lg">' + t.brand + ' ' + t.model + '</div>' +
            '<div class="text-sm text-gray-500 mt-1">' + t.spec + '</div>' +
            '<div class="text-xl font-extrabold text-[#002C5F] mt-2">' + t.price + '/-</div>' +
            '<a href="' + t.wa + '" class="block text-center mt-3 bg-[#25D366] text-white font-bold rounded-xl py-3">WhatsApp for details</a>' +
            '</div></div>';
        }).join('');
      })
      .catch(function () {
        var el = document.getElementById('loading');
        if (el) el.innerHTML = 'Could not load stock. <a class="text-[#002C5F] font-semibold" href="https://wa.me/919052110303">WhatsApp us</a> for the latest list.';
      });
  </script>
</Layout>
