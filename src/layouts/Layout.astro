---
import SEOHead from '../components/SEOHead.astro';
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: string;
  noOrgSchema?: boolean;
}

const { title, description, canonical, image, ogType, noOrgSchema } = Astro.props;

const navLinks = [
  { label: "Cars",      href: "/#cars" },
  { label: "Locations", href: "/locations" },
  { label: "Service",   href: "/service" },
  { label: "Guides",    href: "/blog" },
  { label: "Contact",   href: "/contact" },
];

const showrooms = [
  { label: "Nizamabad", href: "/contact",              phone: "+91 9052116511" },
  { label: "Armoor",    href: "/locations/armoor",     phone: "+91 9052116509" },
  { label: "Bodhan",    href: "/locations/bodhan",     phone: "+91 9052116513" },
  { label: "Banswada",  href: "/locations/banswada",   phone: "+91 9603908891" },
  { label: "Kamareddy", href: "/locations/kamareddy",  phone: "+91 7036219618" },
  { label: "Adilabad",  href: "/locations/adilabad",   phone: "+91 9052110303" },
];

const WA_HEADER = "https://wa.me/919052110303?text=Hi%2C%20I%20want%20to%20know%20about%20Hyundai%20cars%20in%20Nizamabad.%20%5BW-PH%5D";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />
    <meta name="theme-color" content="#002C5F" />
    <!-- GTM preconnect/dns-prefetch for faster tag loading -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Hyundai's own type runs light: 300–500, never black. -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-52SXCPMR');</script>
    <!-- End Google Tag Manager -->
    <SEOHead title={title} description={description} canonical={canonical} image={image} ogType={ogType} noOrgSchema={noOrgSchema} />
  </head>
  <body class="bg-paper text-body font-sans antialiased flex flex-col min-h-screen">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-52SXCPMR"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Header — N9 Edge-aligned: wordmark hard left, nav hard right, one hairline. -->
    <header class="sticky top-0 z-50 bg-paper/95 backdrop-blur-md border-b border-rule">
      <div class="mx-auto max-w-[1400px] px-5 sm:px-8 h-16 lg:h-[72px] flex items-center justify-between gap-4">
        <a href="/" class="min-w-0 group" aria-label="Prakash Hyundai Nizamabad — home">
          <span class="block text-lg lg:text-xl tracking-[0.02em] text-hyundai-blue whitespace-nowrap">
            <span class="font-medium">PRAKASH</span> <span class="font-light">HYUNDAI</span>
          </span>
          <span class="block text-[10px] font-medium uppercase tracking-eyebrow text-muted leading-none mt-0.5">
            Authorised dealer · Nizamabad
          </span>
        </a>

        <div class="flex items-center gap-5 lg:gap-8">
          <nav class="hidden lg:flex items-center gap-8" aria-label="Primary">
            {navLinks.map(link => (
              <a
                href={link.href}
                class="relative py-2 text-sm text-ink2 transition-colors duration-150 ease-out hover:text-hyundai-blue after:absolute after:inset-x-0 after:-bottom-px after:h-px after:bg-hyundai-active after:scale-x-0 after:origin-left after:transition-transform after:duration-200 hover:after:scale-x-100"
              >
                {link.label}
              </a>
            ))}
          </nav>

          <a href={WA_HEADER} target="_blank" rel="noopener noreferrer" class="hy-btn !min-h-[2.75rem] !py-2.5">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.5 14c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.1-1.8-.1a13 13 0 0 1-5.7-4.6c-.4-.6-1-1.5-1-2.9s.7-2 1-2.3a1 1 0 0 1 .7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2 0 .4-.1.6l-.4.5c-.1.2-.3.3-.1.6a9.4 9.4 0 0 0 3.7 3c.3.2.5.1.6 0l.8-1c.2-.2.3-.2.6-.1l1.9.9c.3.1.5.2.5.4v.9Z"/></svg>
            <span class="hidden sm:inline">WhatsApp</span>
          </a>

          <details class="lg:hidden group">
            <summary class="hy-btn hy-btn--outline !px-4 !min-h-[2.75rem] list-none cursor-pointer [&::-webkit-details-marker]:hidden" aria-label="Open menu">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" class="group-open:hidden"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" class="hidden group-open:block"><path d="M5 5l14 14M19 5L5 19"/></svg>
              <span class="sr-only">Menu</span>
            </summary>
            <div class="absolute left-0 right-0 top-full bg-paper border-b border-rule shadow-lg">
              <nav class="mx-auto max-w-[1400px] px-5 sm:px-8" aria-label="Mobile">
                {navLinks.map(link => (
                  <a href={link.href} class="block py-4 border-b border-rule last:border-0 text-sm text-ink hover:text-hyundai-blue transition-colors duration-150">
                    {link.label}
                  </a>
                ))}
              </nav>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer — Ft4 Multi-location grid: nine showrooms earn a real directory. -->
    <footer class="mt-auto">
      <div class="bg-hyundai-sand">
        <div class="mx-auto max-w-[1400px] px-5 sm:px-8 py-14 lg:py-20">
          <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]">
            <div>
              <p class="text-xl tracking-[0.02em] text-hyundai-blue">
                <span class="font-medium">PRAKASH</span> <span class="font-light">HYUNDAI</span>
              </p>
              <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink2">
                Authorised Hyundai dealer for Nizamabad and the surrounding districts.
                Sales, service and genuine parts since 2008.
              </p>
              <address class="mt-6 not-italic text-sm leading-relaxed text-ink2">
                Hyderabad Road, Dichpally<br />
                Nizamabad, Telangana 503001
              </address>
              <p class="mt-3 text-sm text-ink2">
                <a href="tel:+919052110303" class="hover:text-hyundai-blue transition-colors duration-150">+91 90521 10303</a>
                <span class="text-muted"> · sales</span><br />
                <a href="tel:+919052116511" class="hover:text-hyundai-blue transition-colors duration-150">+91 90521 16511</a>
                <span class="text-muted"> · showroom</span>
              </p>
            </div>

            <div class="grid gap-10 sm:grid-cols-2">
              <div>
                <p class="hy-eyebrow !text-hyundai-blue">Showrooms</p>
                <ul class="mt-4">
                  {showrooms.map(s => (
                    <li>
                      <a href={s.href} class="hy-row-link !border-hyundai-sand2 text-sm">
                        <span>{s.label}</span>
                        <span class="text-xs text-ink2">{s.phone}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a href="/locations" class="mt-4 inline-block text-sm text-hyundai-blue underline underline-offset-4 decoration-hyundai-sand2 hover:decoration-hyundai-blue transition-colors duration-150">
                  All nine locations
                </a>
              </div>

              <div>
                <p class="hy-eyebrow !text-hyundai-blue">Sections</p>
                <ul class="mt-4 space-y-3 text-sm">
                  {navLinks.map(link => (
                    <li><a href={link.href} class="text-ink2 hover:text-hyundai-blue transition-colors duration-150">{link.label}</a></li>
                  ))}
                </ul>
                <p class="hy-eyebrow !text-hyundai-blue mt-8">Follow</p>
                <ul class="mt-4 space-y-3 text-sm">
                  <li><a href="https://www.facebook.com/prakashhyundai" target="_blank" rel="noopener noreferrer" class="text-ink2 hover:text-hyundai-blue transition-colors duration-150">Facebook</a></li>
                  <li><a href="https://www.instagram.com/prakashhyundai" target="_blank" rel="noopener noreferrer" class="text-ink2 hover:text-hyundai-blue transition-colors duration-150">Instagram</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-hyundai-blue text-white">
        <div class="mx-auto max-w-[1400px] px-5 sm:px-8 py-6 space-y-2 text-xs text-white/70">
          <p>
            Part of the Prakash Group, serving North Telangana since 2003:
            <a href="https://www.prakashautohonda.com" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-white">Prakash Auto Honda — Honda Bikes, Kamareddy</a> ·
            <a href="https://www.prakashmotors.in" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-white">Prakash Motors — New Holland Tractors</a> ·
            <a href="https://www.sairamhonda.com" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-white">Sairam Honda — Honda Bikes, Nizamabad</a>
          </p>
          <p>© {new Date().getFullYear()} Prakash Hyundai. Authorised Hyundai dealer. Hyundai is a trademark of Hyundai Motor Company.</p>
        </div>
      </div>
    </footer>

      <!-- Lead source tracking: stamps WhatsApp links with traffic source (Google Ads vs Organic). Astro needs is:inline. -->
    <script is:inline>
    (function () {
      try {
        var LS = window.localStorage;
        var qp = new URLSearchParams(location.search);
        function classify() {
          if (LS.getItem('lead_src')) return; // first-touch only
          var gclid = qp.get('gclid') || qp.get('gbraid') || qp.get('wbraid');
          var gad = qp.get('gad_source') || qp.get('gclsrc');
          var um = (qp.get('utm_medium') || '').toLowerCase();
          var us = (qp.get('utm_source') || '').toLowerCase();
          var src = null, g = null;
          if (gclid || gad || um === 'cpc' || um === 'ppc' || um === 'paid') {
            src = 'gads'; if (gclid) g = gclid.slice(0, 512);
          } else if (us === 'google') {
            src = 'org_google';
          } else if (us) {
            src = 'utm_' + us.replace(/[^a-z0-9_]/g, '').slice(0, 16);
          } else {
            var ref = document.referrer || '';
            if (/[.\/]google\./i.test(ref)) src = 'org_google';
            else if (/bing\.|duckduckgo|yahoo\./i.test(ref)) src = 'org_search';
            else if (/facebook|instagram|fb\.|t\.co|twitter|x\.com/i.test(ref)) src = 'social';
            else if (ref && ref.indexOf(location.hostname) === -1) src = 'ref';
            else src = 'direct';
          }
          LS.setItem('lead_src', src);
          if (g) LS.setItem('lead_gclid', g);
          LS.setItem('lead_lp', (location.pathname || '/').slice(0, 40));
        }
        function tagLinks() {
          var s = LS.getItem('lead_src') || 'direct';
          var g = LS.getItem('lead_gclid');
          var tag = ' [wsrc:' + s + (g ? ('|g:' + g) : '') + ']';
          var links = document.querySelectorAll('a[href*="wa.me"], a[href*="api.whatsapp"]');
          for (var i = 0; i < links.length; i++) {
            var a = links[i];
            if (a.getAttribute('data-wsrc')) continue;
            var href = a.getAttribute('href'); if (!href) continue;
            var tm = href.match(/[?&]text=([^&#]*)/);
            var text = 'Hi';
            try { text = tm ? decodeURIComponent(tm[1]) : 'Hi'; } catch (de) {}
            text += tag;
            a.setAttribute('href', 'https://grow.prk.sh/api/wa/click?c=hyundai'
              + '&u=' + encodeURIComponent((location.href || '').slice(0, 500))
              + '&s=' + encodeURIComponent(s)
              + (g ? '&gclid=' + encodeURIComponent(g) : '')
              + '&text=' + encodeURIComponent(text));
            a.setAttribute('data-wsrc', '1');
          }
        }
        classify();
        tagLinks();
        document.addEventListener('click', tagLinks, true);   // catch links added after load
        window.addEventListener('load', tagLinks);
      } catch (e) {}
    })();
    </script>

  </body>
</html>
