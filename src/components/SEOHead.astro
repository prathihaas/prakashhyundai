---
// SEOHead.astro — Prakash Hyundai
const {
  title = "Prakash Hyundai | Authorized Hyundai Dealer in Nizamabad, Telangana",
  description = "Prakash Hyundai is an authorized Hyundai dealership in Nizamabad, Telangana 503001. Explore new Hyundai cars, book test drives, and get expert service.",
  canonical = Astro.url.href,
  image = "/og-image.jpg",
  ogType = "website",
  noOrgSchema = false,
} = Astro.props;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "AutoDealer",
  "@id": "https://www.prakashhyundai.com/#organization",
  "name": "Prakash Hyundai",
  "url": "https://www.prakashhyundai.com",
  "logo": "https://www.prakashhyundai.com/logo.png",
  "image": "https://www.prakashhyundai.com/og-image.jpg",
  "description": "Authorized Hyundai dealership in Nizamabad, Telangana. New Hyundai cars, service, and genuine spare parts.",
  "foundingDate": "2008",
  "telephone": "+91-9052110303",
  "brand": { "@type": "Brand", "name": "Hyundai" },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Hyderabad Road, Dichpally",
    "addressLocality": "Nizamabad",
    "addressRegion": "Telangana",
    "postalCode": "503001",
    "addressCountry": "IN"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 18.6725, "longitude": 78.0941 },
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
    "opens": "09:00",
    "closes": "19:00"
  }],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.7",
    "reviewCount": "2915",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Bodige" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Prakash Hyundai showroom is the best in Nizamabad for 15+ years. Quick services, free test drives, certified mechanics, friendly staff, on-time delivery and car wash. Very satisfied!"
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Sreenaiah" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Excellent experience with the team. Very happy with Prakash Hyundai treatment in the showroom. Best Hyundai dealer in Nizamabad."
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Sree" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Nice behaviour of the staff. Really love the way they treated us. The entire buying experience was smooth and pleasant."
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Venkat" },
      "reviewRating": { "@type": "Rating", "ratingValue": "4", "bestRating": "5" },
      "reviewBody": "Good service and prompt response. The service team is attentive and gets the job done quickly. Highly recommend!"
    }
  ],
  "areaServed": ["Nizamabad", "Kamareddy", "Nirmal", "Armoor", "Balkonda", "Banswada", "Bodhan", "Yellareddy", "Karimnagar", "Telangana"],
  "sameAs": [
    "https://www.facebook.com/prakashhyundai",
    "https://www.instagram.com/prakashhyundai"
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonical,
  "url": canonical,
  "name": title,
  "description": description,
  "isPartOf": { "@id": "https://www.prakashhyundai.com/#organization" },
  "inLanguage": "en-IN"
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL(image, Astro.site).toString()} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:site_name" content="Prakash Hyundai" />
<meta property="og:locale" content="en_IN" />
<meta property="og:locale:alternate" content="te_IN" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site).toString()} />

<!-- Geo Tags -->
<meta name="geo.region" content="IN-TG" />
<meta name="geo.placename" content="Nizamabad, Telangana" />
<meta name="geo.position" content="18.6725;78.0941" />
<meta name="ICBM" content="18.6725, 78.0941" />

<!-- Hreflang -->
<link rel="alternate" hreflang="en" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<!-- JSON-LD Structured Data -->
{!noOrgSchema && <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />}
<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
